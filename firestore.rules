rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- POMOCNÉ GLOBÁLNÍ FUNKCE ---
    function isLogged() {
      return request.auth != null;
    }
    
    function isSuperAdmin() {
      return isLogged() && request.auth.token.isSuperAdmin == true;
    }
    
    function isAdmin() {
      return isSuperAdmin() || (isLogged() && request.auth.token.isAdmin == true);
    }

    // 🔒 BEZPEČNÁ KONTROLA: Povolí hráči přidat POUZE a VÝHRADNĚ "Ligu mistrů"
    function isValidLeagueEnrollment() {
      let oldL = resource.data.get('leagues', []);
      let newL = request.resource.data.get('leagues', []);
      return newL.toSet().difference(oldL.toSet()) == ['Liga mistrů'].toSet() &&
             oldL.toSet().difference(newL.toSet()) == [].toSet();
    }

    // --- KOLEKCE UŽIVATELŮ A SEZÓNNÍ MONOLITY ---
    match /users/{userId} {
      // 🔒 Bezpečné čtení: Hráč vidí svůj profil pro přihlášení, Admin vidí všechny pro soupisku
      allow read: if isLogged() && (request.auth.uid == userId || isAdmin());
      
      // 🔓 Povolí vytvoření profilu (přidělení admin práv blokováno)
      allow create: if isLogged() && (
        isSuperAdmin() || (
          request.auth.uid == userId && 
          request.resource.data.get('isAdmin', false) == false && 
          request.resource.data.get('isSuperAdmin', false) == false
        )
      );

      // 🛡️ NEPRŮSTŘELNÝ UPDATE: Admin smí vše, hráč smí upravit profil, 24h cooldown na pořadí a zapsat POUZE Ligu mistrů
      allow update: if isLogged() && (
        isAdmin() ||
        (
          request.auth.uid == userId && 
          request.resource.data.get('isAdmin', false) == false && 
          request.resource.data.get('isSuperAdmin', false) == false &&
          
          // 🛑 ZÁKAZ ZMĚNY ADMIN PRÁV
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isAdmin', 'isSuperAdmin']) &&
          
          // 🏆 LICENCE: Buď se na pole 'leagues' nesahá, nebo se zapisuje POUZE 'Liga mistrů'
          (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['leagues']) ||
            isValidLeagueEnrollment()
          ) &&
          
          // ⏱️ 24H COOLDOWN: Platí pouze pro uživatelské pořadí soutěží (leagueOrder)
          (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['leagueOrder']) ||
            !('lastLeagueOrderChange' in resource.data) ||
            request.time > resource.data.lastLeagueOrderChange + duration.value(24, 'h')
          )
        )
      );
      
      allow delete: if isSuperAdmin() || isAdmin();

      // 🔒 SEZÓNNÍ TIPY: Čtení pro majitele/admina, zápis přes Cloud Functions (Admin SDK)
      match /sezony/{sezonaId} {
        allow read: if isLogged() && (request.auth.uid == userId || isAdmin());
        allow write: if isAdmin();
        
        match /{subcollection=**} {
          allow read: if isLogged() && (request.auth.uid == userId || isAdmin());
          allow write: if isAdmin();
        }
      }
    }

    // --- LIGOVÝ APARÁT, SEZÓNY A ZÁPASY ---
    match /ligy/{ligaId} {
      allow read: if isLogged();
      allow write: if isAdmin();

      match /sezony/{sezonaId} {
        allow read: if isLogged();
        allow write: if isAdmin();

        match /zapasy/{zapasId} {
          allow read: if isLogged();
          allow write: if isAdmin();
        }
      }

      match /zapasy/{zapasId} {
        allow read: if isLogged();
        allow write: if isAdmin();
      }

      match /stav/{stavId} {
        allow read: if isLogged();
        allow write: if isAdmin();
      }
    }

    // --- SYSTÉMOVÁ KONFIGURACE (BOT CONFIG / SYSTEM) ---
    match /system/{docId} {
      allow read: if isLogged();
      allow write: if isAdmin();
    }

    // --- DOPLŇKOVÉ KOLEKCE (ONLINE RADARY) ---
    match /uzivatele_online/{userId} {
      allow read: if isLogged();
      allow write: if isLogged() && request.auth.uid == userId;
    }

    // --- 📊 PRŮZKUMY & ANKETY (TIPNI PREMIER CUP) ---
    match /ankety/{anketaId} {
      allow read: if isLogged();
      allow write: if isAdmin();

      match /hraci/{userId} {
        allow read: if isLogged() && (request.auth.uid == userId || isAdmin());
        allow write: if isLogged() && (request.auth.uid == userId || isAdmin());
      }
    }
  }
}